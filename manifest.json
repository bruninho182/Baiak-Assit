{
  "manifest_version": 3,
  "name": "Baiak Helper",
  "version": "2.0",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://baiakidle.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://baiakidle.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon128.png"],
      "matches": ["<all_urls>"]
    }
  ]
}